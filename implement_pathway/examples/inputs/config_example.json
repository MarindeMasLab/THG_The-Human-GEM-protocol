    "database_file": "examples/outputs/data/metabolite_id_database.json",
    "targets": [
      "ATP",
      "ADP",
      "GTP",
      "GDP",
      "H2O",
      "Phosphate",
      "H+",
      "L-alanine",
      "L-arginine",
      "L-glycine",
      "L-serine"
    ],
    "cytoskeleton_specific": {
      "example protein": {
        "charge": -5,
        "formula": "C100H150N30O40S2",
        "uniprot": "P00000",
        "sbo": "SBO:0000247"
      }
    }
  },
  "reactions": [
    {
      "id": "R_Example_Transport_ATP",
      "name": "Transport of ATP from cytosol to cytoskeleton",
