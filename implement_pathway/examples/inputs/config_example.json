      "lower_bound": -1000.0,
      "upper_bound": 1000.0,
      "sbo": "SBO:0000185"
    },
    {
      "id": "R_Example_Synthesis",
      "name": "Synthesis of example protein",
      "description": "Simple protein synthesis example",
      "equation": "10 L-alanine[ck] + 5 L-arginine[ck] + 5 L-glycine[ck] + 5 L-serine[ck] + 100 ATP[ck] + 100 H2O[ck] --> 1 example protein[ck] + 100 ADP[ck] + 100 Phosphate[ck] + 100 H+[ck]",
      "subsystem": "Example pathway synthesis",
      "ec": "6.1.-.-",
      "lower_bound": 0.0,
      "upper_bound": 1000.0,
      "sbo": "SBO:0000176"
    },
    {
      "id": "DM_Example_Protein",
      "name": "Demand reaction for example protein",
      "description": "Allows flux through example protein pathway",
      "equation": "1 example protein[ck] -->",
      "subsystem": "Example pathway demand",
      "lower_bound": 0.0,
      "upper_bound": 1000.0,
      "sbo": "SBO:0000628"
    }
  ]
